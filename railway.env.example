# ==============================================================================
# VARIÁVEIS DE AMBIENTE PARA DEPLOY NO RAILWAY (Tenshi Bot Imperial)
# Cole estas variáveis em: Railway -> Seu Projeto -> bot-tenshi -> Variables
# ==============================================================================

# TOKEN DO BOT DO DISCORD (OBRIGATÓRIO)
# Obtenha em: https://discord.com/developers/applications -> Seu Bot -> Bot -> Reset Token
# ATENÇÃO: Cole APENAS o token, SEM aspas duplas, SEM aspas simples e SEM 'Bot ' na frente.
DISCORD_TOKEN=

# INTELIGÊNCIA ARTIFICIAL (IA IMPERIAL)
# Chaves opcionais: OpenRouter, OpenAI ou Gemini
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# PAINEL WEB ADMINISTRATIVO (HTTP /health)
ENABLE_SITE=1
ADMIN_USERNAME=Alloy
ADMIN_PASSWORD=
ADMIN_SECRET=

# ARMAZENAMENTO PERSISTENTE (Opcional - caso adicione um Volume no Railway)
TENSHI_DATA_DIR=/data
TENSHI_DB_PATH=/data/tenshi.db
